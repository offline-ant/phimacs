{
  "name": "phimacs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/pimux",
    "packages/orchestration",
    "packages/extensions",
    "packages/browser",
    "packages/sound"
  ],
  "scripts": {
    "compile": "npm run compile --workspaces",
    "check": "node scripts/check.mjs",
    "update:pi": "node scripts/update-pi.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "$@earendil-works/pi-agent-core",
    "@earendil-works/pi-ai": "$@earendil-works/pi-ai",
    "@earendil-works/pi-tui": "$@earendil-works/pi-tui",
    "@earendil-works/pi-coding-agent": "$@earendil-works/pi-coding-agent"
  }
}
