{
  "name": "@phimacs/browser",
  "version": "0.1.0",
  "description": "Shared Chromium/Firefox automation and Codex or browser-backed web tools for Pi and SDK applications",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offline-ant/phimacs.git",
    "directory": "packages/browser"
  },
  "keywords": [
    "pi-package",
    "browser",
    "web-search"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    "./cdp": {
      "types": "./dist/core/cdp.d.ts",
      "default": "./dist/core/cdp.js"
    }
  },
  "files": [
    "dist",
    "host-modules.ts",
    "bin/browser-open",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./host-modules.ts",
      "./dist/extension.js"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "compile": "node ../../scripts/compile-package.mjs",
    "prepack": "npm run compile"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "dependencies": {
    "@phimacs/pimux": "0.1.0",
    "ws": "8.21.3"
  }
}
