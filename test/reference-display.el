;;; reference-display.el --- Isolated GUI and terminal UI evidence -*- lexical-binding: t; -*-
(load (expand-file-name "reference-fixtures.el" (file-name-directory load-file-name)) nil t)
(phimacs-reference-load-ui)
(let* ((kind (getenv "PHIMACS_TEST_DISPLAY"))
       (graphic (and (display-graphic-p) t))
       (colors (display-color-cells))
       (output (getenv "PHIMACS_TEST_EVIDENCE")))
  (unless (equal graphic (equal kind "gui")) (error "Unexpected frame type"))
  (when (equal kind "tty256") (unless (= colors 256) (error "Expected 256-colour terminal")))
  (when (equal kind "ttytrue") (unless (> colors 256) (error "Expected truecolour terminal")))
  (switch-to-buffer (get-buffer-create "Phimacs reference UI"))
  (text-mode)
  (insert "Phimacs reference environment\n\nDracula · M-m leader · completion\n\nProvider authentication and optional integrations are explicit.\nNo agent runtime was started by this display test.\n")
  (goto-char (point-min))
  (redisplay t)
  (with-temp-file output
    (insert (json-serialize `(:kind ,kind :graphic ,(if graphic t :false)
                             :colors ,colors :dark ,(if (eq frame-background-mode 'dark) t :false)
                             :evil ,(if (bound-and-true-p evil-mode) t :false)
                             :mouse ,(if xterm-mouse-mode t :false)))))
  (when (and graphic (fboundp 'x-export-frames))
    (let ((coding-system-for-write 'binary))
      (write-region (x-export-frames nil 'png) nil (concat output ".png") nil 'silent)))
  (kill-emacs 0))
;;; reference-display.el ends here
