(require 'ert)
(require 'pi-deck)
(require 'ghostel)

(defmacro phimacs-deck-with-state (&rest body)
  "Run BODY with isolated deck state and no real Pi or service."
  (declare (indent 0))
  `(let* ((directory (make-temp-file "phimacs-deck-" t))
          (pi-deck-state-file (expand-file-name "state.eld" directory))
          (pi-deck-preferences-file (expand-file-name "preferences.eld" directory))
          (user-emacs-directory (file-name-as-directory directory))
          (pi-deck--agents (make-hash-table :test 'eq))
          (pi-deck-spaces nil) (pi-deck--layouts nil) (pi-deck--last-space nil)
          (pi-deck--finished-workers nil) (pi-deck--pending-reveal nil)
          (pi-deck--last-saved nil) (pi-deck--saved-structure nil)
          (pi-deck--state-owner "/synthetic/owner") (pi-deck--state-claimed t)
          (pi-deck--state-backup-pending nil) (pi-deck--restoring nil)
          (pi-deck-save-delay nil) (pi-deck-restore-interval 0)
          (pi-deck-new-space-action 'dired) (pi-deck-sidebar nil)
          (tab-bar-tabs-function #'tab-bar-tabs)
          (kill-buffer-query-functions nil))
     (set-frame-parameter nil 'tabs nil)
     (unwind-protect (progn ,@body)
       (pi-deck-mode -1)
       (dolist (timer (list pi-deck--update-timer pi-deck--save-timer))
         (when (timerp timer) (cancel-timer timer)))
       (setq pi-deck--update-timer nil pi-deck--save-timer nil)
       (set-frame-parameter nil 'tabs nil)
       (delete-other-windows)
       (switch-to-buffer "*scratch*")
       (delete-directory directory t))))

(ert-deftest phimacs-deck-empty-owned-state-replaces-previous-spaces ()
  (phimacs-deck-with-state
    (setq pi-deck-spaces (list (list :name "removed" :dir directory)))
    (pi-deck--save-now)
    (setq pi-deck-spaces nil)
    (pi-deck--save-now)
    (should-not (plist-get (pi-deck-read-state) :spaces))
    (should-not (plist-get (pi-deck-read-state) :agents))))

(ert-deftest phimacs-deck-empty-save-keeps-owner-and-restore-guards ()
  (phimacs-deck-with-state
    (let ((pi-deck--state-owner nil)) (pi-deck--save-now))
    (should-not (file-exists-p pi-deck-state-file))
    (let ((pi-deck--restoring t)) (pi-deck--save-now))
    (should-not (file-exists-p pi-deck-state-file))))

(ert-deftest phimacs-deck-repeated-enable-restores-original-preferences ()
  (phimacs-deck-with-state
    (let ((pilish-extension-dialog-style 'minibuffer)
          (pilish-window-pairing-mode nil)
          (tab-bar-show 7)
          (pi-orchestration-show-session-function #'ignore))
      (pi-deck-mode 1)
      (let ((timer pi-deck--refresh-timer))
        (pi-deck-mode 1)
        (should (eq timer pi-deck--refresh-timer)))
      (pi-deck-mode -1)
      (should (eq pilish-extension-dialog-style 'minibuffer))
      (should-not pilish-window-pairing-mode)
      (should (= tab-bar-show 7))
      (should (eq pi-orchestration-show-session-function #'ignore))
      (pi-deck-mode -1)
      (should (= tab-bar-show 7)))))

(ert-deftest phimacs-deck-disable-removes-owned-ui-hooks-timers-not-agents ()
  (phimacs-deck-with-state
    (let* ((buffer (generate-new-buffer "*phimacs-owned-shell*"))
           (process (make-pipe-process :name "phimacs-owned-shell" :buffer buffer :noquery t)))
      (unwind-protect
          (progn
            (pi-deck-mode 1)
            (puthash buffer (pi-deck-agent--make :buffer buffer :kind 'shell) pi-deck--agents)
            (with-current-buffer buffer (setq-local header-line-format "original header"))
            (pi-deck-headers-update)
            (pi-deck--sidebar-resize-later (selected-frame))
            (setq pi-deck--panel-timers (list (run-with-timer 100 nil #'ignore)))
            (setq pi-deck--update-timer (run-with-timer 100 nil #'ignore)
                  pi-deck--save-timer (run-with-timer 100 nil #'ignore))
            (set-frame-size nil 150 50)
            (setq pi-deck-sidebar t)
            (pi-deck--sidebar-sync)
            (tab-bar-new-tab)
            (pi-deck--sidebar-sync)
            (should (get-buffer-window pi-deck-sidebar-buffer-name))
            (pi-deck-mode -1)
            (should (process-live-p process))
            (should-not pi-deck--refresh-timer)
            (should-not pi-deck--update-timer)
            (should-not pi-deck--save-timer)
            (should-not pi-deck--sidebar-resize-timers)
            (should-not pi-deck--panel-timers)
            (should (equal "original header" (buffer-local-value 'header-line-format buffer)))
            (should-not (advice-member-p #'pi-deck--shell-mark 'ghostel--osc133-marker))
            (should-not (memq #'pi-deck--shell-exited ghostel-exit-functions))
            (dolist (hook pi-deck--hooks)
              (should-not (memq (cdr hook) (symbol-value (car hook)))))
            (dolist (index '(1 2))
              (tab-bar-select-tab index)
              (should-not (get-buffer-window pi-deck-sidebar-buffer-name))))
        (when (process-live-p process) (delete-process process))
        (kill-buffer buffer)
        (set-frame-size nil 80 25)))))

(ert-deftest phimacs-deck-disable-preserves-incomplete-restore-file ()
  (phimacs-deck-with-state
    (with-temp-file pi-deck-state-file (insert "(:version 2 :spaces ((:name \"pending\")))\n"))
    (let ((before (with-temp-buffer (insert-file-contents pi-deck-state-file) (buffer-string))))
      (pi-deck-mode 1)
      (setq pi-deck--restoring (run-with-timer 100 nil #'ignore)
            pi-deck--save-timer (run-with-timer 100 nil #'ignore))
      (pi-deck-mode -1)
      (should (equal before (with-temp-buffer (insert-file-contents pi-deck-state-file) (buffer-string)))))))

(ert-deftest phimacs-deck-restart-helper-failure-never-exits ()
  (phimacs-deck-with-state
    (let ((pi-deck-restart-command '("/bin/true")) killed)
      (cl-letf (((symbol-function 'pi-deck-server-running-p) #'always)
                ((symbol-function 'call-process) (lambda (&rest _) 42))
                ((symbol-function 'kill-emacs) (lambda (&rest _) (setq killed t))))
        (should-error (pi-deck-restart-daemon t))
        (should-not killed)))))

(ert-deftest phimacs-deck-missing-restart-command-never-exits ()
  (phimacs-deck-with-state
    (let ((pi-deck-restart-command '("/nonexistent-phimacs-command")) killed called)
      (cl-letf (((symbol-function 'pi-deck-server-running-p) #'always)
                ((symbol-function 'call-process) (lambda (&rest _) (setq called t) 0))
                ((symbol-function 'kill-emacs) (lambda (&rest _) (setq killed t))))
        (should-error (pi-deck-restart-daemon t))
        (should-not called)
        (should-not killed)))))

(ert-deftest phimacs-deck-supervised-restart-needs-explicit-delegation ()
  (phimacs-deck-with-state
    (let ((pi-deck-restart-mode 'supervised)
          (pi-deck-supervisor-restart-command nil) killed called)
      (cl-letf (((symbol-function 'pi-deck-server-running-p) #'always)
                ((symbol-function 'call-process) (lambda (&rest _) (setq called t) 0))
                ((symbol-function 'kill-emacs) (lambda (&rest _) (setq killed t))))
        (should-error (pi-deck-restart-daemon t))
        (should-not called)
        (should-not killed)))))

(ert-deftest phimacs-deck-unbound-callback-is-restored-as-unbound ()
  (phimacs-deck-with-state
    (let ((was-bound (boundp 'pi-orchestration-show-session-function))
          (original (and (boundp 'pi-orchestration-show-session-function)
                         pi-orchestration-show-session-function)))
      (unwind-protect
          (progn
            (makunbound 'pi-orchestration-show-session-function)
            (pi-deck-mode 1)
            (pi-deck-mode -1)
            (should-not (boundp 'pi-orchestration-show-session-function)))
        (when was-bound (setq pi-orchestration-show-session-function original))))))

(ert-deftest phimacs-deck-zero-helper-status-without-ack-never-exits ()
  (phimacs-deck-with-state
    (let ((pi-deck-restart-command '("/bin/true"))
          (pi-deck-restart-prepare-timeout 0.01) killed)
      (cl-letf (((symbol-function 'pi-deck-server-running-p) #'always)
                ((symbol-function 'call-process) (lambda (&rest _) 0))
                ((symbol-function 'kill-emacs) (lambda (&rest _) (setq killed t))))
        (should-error (pi-deck-restart-daemon t))
        (should-not killed)))))

(ert-deftest phimacs-deck-save-failure-cancels-prepared-restart ()
  (phimacs-deck-with-state
    (let ((operation (make-temp-file "phimacs-deck-operation-" t)) killed)
      (cl-letf (((symbol-function 'pi-deck-server-running-p) #'always)
                ((symbol-function 'pi-deck--prepare-restart) (lambda (_) operation))
                ((symbol-function 'pi-deck-save-state) (lambda (&rest _) (error "Synthetic disk failure")))
                ((symbol-function 'kill-emacs) (lambda (&rest _) (setq killed t))))
        (should-error (pi-deck-restart-daemon t))
        (should-not killed)
        (should-not (file-exists-p operation))))))

(ert-deftest phimacs-deck-helper-waits-for-commit-and-old-process-exit ()
  (phimacs-deck-with-state
    (let* ((source (make-process :name "phimacs-old-emacs" :command '("/bin/cat")
                                 :connection-type 'pipe :noquery t))
           (pid (process-id source))
           (marker (expand-file-name "replacement-ran" directory))
           operation)
      (unwind-protect
          (progn
            (cl-letf (((symbol-function 'emacs-pid) (lambda () pid)))
              (setq operation (pi-deck--prepare-restart
                               (list "/bin/sh" "-c" (concat "printf ready > " (shell-quote-argument marker))))))
            (should (file-readable-p (expand-file-name "ready" operation)))
            (should-not (file-exists-p marker))
            (with-temp-file (expand-file-name "commit" operation) (insert "commit\n"))
            (accept-process-output nil 0.05)
            (should-not (file-exists-p marker))
            (delete-process source)
            (let ((deadline (+ (float-time) 5)))
              (while (and (not (file-exists-p marker)) (< (float-time) deadline))
                (accept-process-output nil 0.02)))
            (should (file-exists-p marker))
            (should-not (file-exists-p operation)))
        (when (process-live-p source) (delete-process source))
        (when (and operation (file-directory-p operation)) (delete-directory operation t))))))

(ert-deftest phimacs-deck-supervised-command-never-falls-back-to-manual ()
  (phimacs-deck-with-state
    (let ((pi-deck-restart-mode 'supervised)
          (pi-deck-restart-command '("/nonexistent-manual-command"))
          (pi-deck-supervisor-restart-command '("/bin/true")))
      (should (equal (pi-deck-restart-command-line) '("/bin/true"))))))

(ert-deftest phimacs-deck-disable-restores-untracked-header-localness ()
  (phimacs-deck-with-state
    (let ((buffer (generate-new-buffer " *phimacs-untracked-header*")))
      (unwind-protect
          (progn
            (pi-deck-mode 1)
            (with-current-buffer buffer
              (kill-local-variable 'header-line-format)
              (pi-deck--install-header buffer)
              (should (local-variable-p 'header-line-format)))
            (pi-deck-mode -1)
            (with-current-buffer buffer
              (should-not (local-variable-p 'header-line-format))
              (should-not (local-variable-p 'pi-deck--saved-header-line))))
        (kill-buffer buffer)))))

(ert-deftest phimacs-deck-helper-death-before-commit-never-exits ()
  (phimacs-deck-with-state
    (let ((operation (make-temp-file "phimacs-deck-operation-" t)) killed)
      (cl-letf (((symbol-function 'pi-deck-server-running-p) #'always)
                ((symbol-function 'pi-deck--prepare-restart) (lambda (_) operation))
                ((symbol-function 'pi-deck--restart-helper-ready-p) #'ignore)
                ((symbol-function 'kill-emacs) (lambda (&rest _) (setq killed t))))
        (should-error (pi-deck-restart-daemon t))
        (should-not killed)
        (should-not (file-exists-p operation))))))

(ert-deftest phimacs-deck-fresh-ghostel-observers-follow-mode-lifetime ()
  (phimacs-deck-with-state
    (pi-deck-mode 1)
    (let* ((buffer (pi-deck-start-shell
                    directory "lifecycle-probe"
                    '("/bin/sh" "-c" "printf '\\033]133;A\\007$ '; read line")))
           (process (get-buffer-process buffer))
           (deadline (+ (float-time) 5)))
      (unwind-protect
          (progn
            (pi-deck-refresh)
            (while (and (not (eq (pi-deck-agent-state (pi-deck-agent buffer)) 'idle))
                        (< (float-time) deadline))
              (accept-process-output process 0.02))
            (should (eq (pi-deck-agent-state (pi-deck-agent buffer)) 'idle))
            (should (advice-member-p #'pi-deck--shell-mark 'ghostel--osc133-marker))
            (pi-deck-mode -1)
            (should (process-live-p process))
            (should-not (advice-member-p #'pi-deck--shell-mark 'ghostel--osc133-marker))
            (should-not (memq #'pi-deck--shell-exited ghostel-exit-functions)))
        (when (process-live-p process) (delete-process process))
        (kill-buffer buffer)))))

(ert-deftest phimacs-deck-failed-enable-preserves-state-and-original-settings ()
  (phimacs-deck-with-state
    (with-temp-file pi-deck-state-file (insert "(:version 2 :spaces ((:name \"keep\")))\n"))
    (let ((before (with-temp-buffer (insert-file-contents pi-deck-state-file) (buffer-string)))
          (pilish-extension-dialog-style 'minibuffer)
          (tab-bar-show 3)
          (pi-orchestration-show-session-function #'ignore))
      (cl-letf (((symbol-function 'pi-deck-load-preferences) (lambda () (error "Synthetic configuration failure"))))
        (should-error (pi-deck-mode 1)))
      (should-not pi-deck-mode)
      (should-not pi-deck--enabled)
      (should-not pi-deck--refresh-timer)
      (should (eq pilish-extension-dialog-style 'minibuffer))
      (should (= tab-bar-show 3))
      (should (eq pi-orchestration-show-session-function #'ignore))
      (should (equal before (with-temp-buffer (insert-file-contents pi-deck-state-file) (buffer-string)))))))

(ert-deftest phimacs-deck-quit-during-enable-rolls-back-original-settings ()
  (phimacs-deck-with-state
    (let ((pilish-extension-dialog-style 'minibuffer)
          (pilish-window-pairing-mode nil)
          (tab-bar-show 3)
          (pi-orchestration-show-session-function #'ignore)
          cancelled)
      (cl-letf (((symbol-function 'pi-deck-load-preferences) (lambda () (signal 'quit nil))))
        (condition-case nil (pi-deck-mode 1) (quit (setq cancelled t))))
      (should cancelled)
      (should-not pi-deck-mode)
      (should-not pi-deck--enabled)
      (should-not pi-deck--refresh-timer)
      (should-not pilish-window-pairing-mode)
      (should (eq pilish-extension-dialog-style 'minibuffer))
      (should (= tab-bar-show 3))
      (should (eq pi-orchestration-show-session-function #'ignore)))))

(ert-deftest phimacs-deck-reenable-does-not-reuse-unobserved-shell-phase ()
  (phimacs-deck-with-state
    (pi-deck-mode 1)
    (let* ((buffer (pi-deck-start-shell
                    directory "reenable-probe"
                    '("/bin/sh" "-c" "printf '\\033]133;A\\007$ '; read first; printf '\\033]133;C\\007'; read second")))
           (process (get-buffer-process buffer))
           (deadline (+ (float-time) 5)))
      (unwind-protect
          (progn
            (pi-deck-refresh)
            (while (and (not (eq (pi-deck-agent-state (pi-deck-agent buffer)) 'idle))
                        (< (float-time) deadline))
              (accept-process-output process 0.02))
            (should (eq (pi-deck-agent-state (pi-deck-agent buffer)) 'idle))
            (pi-deck-mode -1)
            (with-current-buffer buffer (ghostel-send-string "start\n"))
            (accept-process-output process 0.05)
            (pi-deck-mode 1)
            (should (eq (pi-deck-agent-state (pi-deck-agent buffer)) 'unknown)))
        (when (process-live-p process) (delete-process process))
        (kill-buffer buffer)))))

