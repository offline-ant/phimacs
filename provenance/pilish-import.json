{
  "package": "pilish",
  "destination": "emacs/pilish",
  "license": "GPL-3.0-or-later",
  "upstream": {
    "repository": "https://github.com/dnouri/pilish.git",
    "incorporatedRevision": "5a83d26a44fc87cf54b52b2f9d80806964dd5634"
  },
  "selection": {
    "input": "committed tracked tree",
    "include": ["."],
    "excludeDirectories": [".github/", "hooks/", ".agents/"],
    "untrackedFiles": "exclude",
    "rejectGeneratedPaths": [
      "**/*.elc",
      "**/*.eln",
      "**/*.pyc",
      "**/.cache/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/tmp/**",
      "**/__pycache__/**"
    ],
    "trackedAssets": "retain required source and intentional documentation assets"
  }
}
