# Focused Pilish checks against explicitly prepared, private inputs.

SHELL = bash
EMACS ?= emacs
ROOT := $(abspath ../..)
# The root graph is the only supported Pi version authority.
PI_VERSION := $(shell node -p 'require("$(ROOT)/package.json").dependencies["@earendil-works/pi-coding-agent"]')
PACKAGE_USER_DIR ?= $(if $(PHIMACS_TEST_EMACS_DIR),$(abspath $(PHIMACS_TEST_EMACS_DIR)/elpa))
GRAMMAR_DIR ?= $(if $(PHIMACS_TEST_EMACS_DIR),$(abspath $(PHIMACS_TEST_EMACS_DIR)/tree-sitter))
# The caller creates this private cache; never use personal native caches.
PILISH_TEST_CACHE_DIR ?=
export EMACS PACKAGE_USER_DIR GRAMMAR_DIR PILISH_TEST_CACHE_DIR
SELECTOR ?=
export SELECTOR

BATCH = $(EMACS) --batch -Q -L . -L scripts \
	--eval '(setq load-prefer-newer t)' \
	-l pilish-build --eval '(pilish-build-test-environment)'
LOCAL_LOAD_PATH = --eval '(add-to-list (quote load-path) (expand-file-name "."))'
BATCH_TEST = $(BATCH) -L test $(LOCAL_LOAD_PATH) -l pilish
ERT_RUN = --eval '(let ((selector (getenv "SELECTOR"))) (if (and selector (> (length selector) 0)) (progn (require (quote ert)) (unless (ert-select-tests selector t) (error "SELECTOR matched no tests: %s" selector)) (ert-run-tests-batch-and-exit selector)) (ert-run-tests-batch-and-exit t)))'

UNIT_SUITES = core session-api dialog queue shared drafts shared-input menu-detached \
	storage runtime runtime-task runtime-watch style pair terminal-image ui render \
	answer arguments benchmark table input menu browse jsonl snapshot build grammars \
	evil fake-pi gui-test-utils integration-test-common
PILISH_SOURCES = pilish-core.el pilish-jsonl.el pilish-grammars.el pilish-ui.el \
	pilish-drafts.el pilish-dialog.el pilish-queue.el pilish-style.el \
	pilish-answer.el pilish-terminal-image.el pilish-pair.el pilish-table.el \
	pilish-render.el pilish-snapshot.el pilish-conversations.el pilish-input.el pilish-send-button.el pilish-menu.el \
	pilish-shared.el pilish-storage.el pilish-runtime-process.el \
	pilish-runtime-task.el pilish-runtime.el pilish-runtime-watch.el pilish-browse.el pilish-evil.el pilish.el
CHECK_SOURCES = scripts/pilish-build.el scripts/install-ts-grammars.el $(PILISH_SOURCES)

.PHONY: help deps check-pi test test-unit test-runtime test-runtime-native test-grammars \
	test-integration-fake test-integration-real test-gui compile check-parens \
	lint lint-checkdoc lint-package check clean bench bench-batch \
	bench-reload-resume bench-reload-resume-batch bench-reload-resume-smoke \
	bench-tool-update bench-tool-update-batch bench-tool-update-smoke \
	bench-stream-delta bench-stream-delta-batch bench-stream-delta-smoke \
	bench-agent-end-cooling bench-agent-end-cooling-batch bench-agent-end-cooling-smoke

help:
	@echo 'Inputs: PHIMACS_TEST_EMACS_DIR (or PACKAGE_USER_DIR and GRAMMAR_DIR), PILISH_TEST_CACHE_DIR'
	@echo '  make test-SUITE          Focused ERT suite (for example test-render or test-build)'
	@echo '  make test-runtime        Runtime, task-evidence and discovery suites'
	@echo '  make test-runtime-native Opt-in synthetic real-Pi/faux lane; see RUNTIME.md'
	@echo '  make test-grammars       Essential grammar API tests (builtins only)'
	@echo '  make compile             Compile owning Lisp and build helpers'
	@echo '  make check-parens        Check owning Lisp syntax'
	@echo '  make lint                Checkdoc and preinstalled package-lint'
	@echo '  make test                All unit tests (SELECTOR=regexp narrows the run)'
	@echo '  make test-unit           Compile and all unit tests'
	@echo '  make check               Compile, lint and all unit tests'
	@echo '  make test-integration-fake Deterministic subprocess contract tests'
	@echo '  make test-integration-real Opt-in: explicit PHIMACS_PI, already running Ollama'
	@echo '  make test-gui            Fake-backed GUI checks; PI_HEADLESS=1 for Xvfb'
	@echo '  make bench[-batch]       Table benchmarks (GUI or batch)'
	@echo '  make bench-{reload-resume,tool-update,stream-delta,agent-end-cooling}[-batch|-smoke]'
	@echo '  make clean               Remove generated bytecode in this source directory'

# Validation only. Provisioning belongs to the root preparation script.
deps:
	@$(BATCH) --eval '(pilish-build-check-deps)'

# Pattern targets retain each owning suite without another test dispatcher.
test-%: deps
	@$(BATCH_TEST) -l pilish-$*-test $(ERT_RUN)

test: deps
	@$(BATCH_TEST) $(foreach suite,$(UNIT_SUITES),-l pilish-$(suite)-test) \
		-l pilish-test $(ERT_RUN)

test-runtime: deps
	@$(BATCH_TEST) -l pilish-runtime-test -l pilish-runtime-task-test \
		-l pilish-runtime-watch-test $(ERT_RUN)

# The native fixture supplies its own marked root, service and selected host.
test-runtime-native: deps
	@$(BATCH_TEST) -l pilish-runtime-native-test $(ERT_RUN)

# This API has no external package dependency.
test-grammars:
	@case "$$PILISH_TEST_CACHE_DIR" in /*) ;; *) echo 'Set PILISH_TEST_CACHE_DIR to an absolute private cache'; exit 1 ;; esac
	@test -d "$$PILISH_TEST_CACHE_DIR"
	@$(EMACS) --batch -Q -L . -L test \
		--eval '(startup-redirect-eln-cache (expand-file-name "eln-cache/" (getenv "PILISH_TEST_CACHE_DIR")))' \
		-l pilish-grammars-test $(ERT_RUN)

test-unit: compile test

check-pi:
	@case "$$PHIMACS_PI" in /*) ;; *) echo 'Set PHIMACS_PI to an absolute isolated Pi executable'; exit 1 ;; esac
	@test -x "$$PHIMACS_PI" || { echo 'PHIMACS_PI is not executable'; exit 1; }
	@VERSION=$$("$$PHIMACS_PI" --version); \
	test "$$VERSION" = "$(PI_VERSION)" || { echo 'Pi must match root SDK $(PI_VERSION)'; exit 1; }

INTEGRATION_BATCH = $(BATCH_TEST) -l pilish-integration-test $(ERT_RUN)
test-integration-fake: deps
	@env PI_RUN_INTEGRATION=1 PI_INTEGRATION_BACKENDS=fake $(INTEGRATION_BATCH)

# No Pi installer or backend service start. Every run owns fresh session state.
test-integration-real: deps check-pi
	@SESSION_DIR=$$(mktemp -d); \
	trap 'rm -rf "$$SESSION_DIR"' EXIT; \
	cp test/fixtures/ollama-models.json "$$SESSION_DIR/models.json"; \
	env PI_CODING_AGENT_DIR="$$SESSION_DIR" PI_CODING_AGENT_SESSION_DIR="$$SESSION_DIR/sessions" \
		PI_RUN_INTEGRATION=1 PI_INTEGRATION_BACKENDS=real \
		$(BATCH_TEST) --eval '(setq pilish-executable (list (getenv "PHIMACS_PI")))' \
		-l pilish-integration-test $(ERT_RUN)

test-gui: deps
	@./test/run-gui-tests.sh $(SELECTOR)

bench: deps
	@./bench/run-bench.sh
bench-batch: deps
	@./bench/run-bench.sh --batch
bench-reload-resume: deps
	@./bench/run-reload-resume-bench.sh
bench-reload-resume-batch: deps
	@./bench/run-reload-resume-bench.sh --batch
bench-reload-resume-smoke: deps
	@./bench/run-reload-resume-bench.sh --batch --scenario smoke -c 1
bench-tool-update: deps
	@./bench/run-tool-update-bench.sh
bench-tool-update-batch: deps
	@./bench/run-tool-update-bench.sh --batch
bench-tool-update-smoke: deps
	@./bench/run-tool-update-bench.sh --batch --scenario smoke -c 1
bench-stream-delta: deps
	@./bench/run-stream-delta-bench.sh
bench-stream-delta-batch: deps
	@./bench/run-stream-delta-bench.sh --batch
bench-stream-delta-smoke: deps
	@./bench/run-stream-delta-bench.sh --batch --scenario smoke -c 1
bench-agent-end-cooling: deps
	@./bench/run-tool-update-bench.sh --scenario agent-end-cooling --out-dir tmp/agent-end-cooling-bench/gui
bench-agent-end-cooling-batch: deps
	@./bench/run-tool-update-bench.sh --batch --scenario agent-end-cooling --out-dir tmp/agent-end-cooling-bench/batch
bench-agent-end-cooling-smoke: deps
	@./bench/run-tool-update-bench.sh --batch --scenario agent-end-cooling-smoke -c 1 --out-dir tmp/agent-end-cooling-bench/smoke

check-parens:
	@$(BATCH) --eval '(dolist (file (list $(foreach source,$(CHECK_SOURCES),"$(source)"))) (with-current-buffer (find-file-noselect file) (check-parens) (message "%s OK" file)))'

compile: deps
	@rm -f *.elc scripts/*.elc
	@$(BATCH) $(LOCAL_LOAD_PATH) --eval '(setq byte-compile-error-on-warn t)' \
		-f batch-byte-compile $(CHECK_SOURCES)

lint: lint-checkdoc lint-package
lint-checkdoc:
	@OUTPUT=$$($(BATCH) --eval '(require (quote checkdoc))' \
		--eval '(setq sentence-end-double-space nil)' \
		--eval '(dolist (file (list $(foreach source,$(CHECK_SOURCES),"$(source)"))) (checkdoc-file file))' 2>&1); \
	STATUS=$$?; printf '%s\n' "$$OUTPUT"; \
	test "$$STATUS" -eq 0 || exit "$$STATUS"; \
	if printf '%s\n' "$$OUTPUT" | grep -q '^Warning'; then exit 1; fi
lint-package: deps
	@$(BATCH) --eval '(require (quote package-lint))' \
		--eval '(setq package-lint-main-file "pilish.el")' \
		-f package-lint-batch-and-exit $(PILISH_SOURCES)

check: compile lint test
clean:
	@rm -f *.elc scripts/*.elc test/*.elc
